####### Compile

game.o: ../game.cpp ../game.h \
		../level.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o game.o ../game.cpp

level.o: ../level.cpp ../level.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o level.o ../level.cpp

astar.o: ../astar.cpp ../astar.h \
		../game.h \
		../level.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o astar.o ../astar.cpp

solveur.o: ../solveur.cpp ../solveur.h \
		../game.h \
		../level.h \
		../solveurbfs.h \
		../solveurastar.h \
		../cle.h \
		../solveurdiagnostic.h \
		../astar.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o solveur.o ../solveur.cpp

solveurbfs.o: ../solveurbfs.cpp ../cle.h \
		../solveurbfs.h \
		../solveur.h \
		../game.h \
		../level.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o solveurbfs.o ../solveurbfs.cpp

solveurastar.o: ../solveurastar.cpp ../solveurastar.h \
		../cle.h \
		../solveur.h \
		../game.h \
		../level.h \
		../solveurdiagnostic.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o solveurastar.o ../solveurastar.cpp

solveurdiagnostic.o: ../solveurdiagnostic.cpp ../solveurdiagnostic.h \
		../cle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o solveurdiagnostic.o ../solveurdiagnostic.cpp

image.o: image.cpp ../../qtiasoko/level.h \
		../../qtiasoko/game.h \
		../level.h \
		../../qtiasoko/sprite.h \
		../../qtiasoko/sol.h \
		../sprite.h \
		../../qtiasoko/mur.h \
		../../qtiasoko/caisse.h \
		../../qtiasoko/goal.h \
		../../qtiasoko/goalcaisse.h \
		../../qtiasoko/player.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o image.o image.cpp

sprite.o: ../sprite.cpp ../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o sprite.o ../sprite.cpp

sol.o: ../sol.cpp ../sol.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o sol.o ../sol.cpp

mur.o: ../mur.cpp ../mur.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mur.o ../mur.cpp

caisse.o: ../caisse.cpp ../caisse.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o caisse.o ../caisse.cpp

goal.o: ../goal.cpp ../goal.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o goal.o ../goal.cpp

goalcaisse.o: ../goalcaisse.cpp ../goalcaisse.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o goalcaisse.o ../goalcaisse.cpp

player.o: ../player.cpp ../player.h \
		../sprite.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o player.o ../player.cpp

qrc_qtiasoko.o: qrc_qtiasoko.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_qtiasoko.o qrc_qtiasoko.cpp

moc_solveur.o: moc_solveur.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_solveur.o moc_solveur.cpp

moc_solveurbfs.o: moc_solveurbfs.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_solveurbfs.o moc_solveurbfs.cpp

moc_solveurastar.o: moc_solveurastar.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_solveurastar.o moc_solveurastar.cpp

####### Install

install:  FORCE

uninstall:  FORCE

FORCE:

